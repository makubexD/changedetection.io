    "friday":    { "enabled": true, "start_time": "08:00", "duration": { "hours": "10", "minutes": "0" } },
    "saturday":  { "enabled": false, "start_time": "08:00", "duration": { "hours": "0", "minutes": "0" } },
    "sunday":    { "enabled": false, "start_time": "08:00", "duration": { "hours": "0", "minutes": "0" } },

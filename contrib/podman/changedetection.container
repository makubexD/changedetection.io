# Quadlet unit for running changedetection.io under rootless Podman + systemd.
# This is the native-Podman deployment path -- no compose binary required.
#
# Install (rootless, as your normal user -- do NOT use sudo):
#   mkdir -p ~/.config/containers/systemd
#   cp changedetection.container changedetection.volume changedetection.network \
#      ~/.config/containers/systemd/
#   systemctl --user daemon-reload
#   systemctl --user start changedetection
#   systemctl --user status changedetection
#   journalctl --user -u changedetection -f
#
# Survive logout (otherwise systemd stops your user session's units):
#   loginctl enable-linger $USER

[Unit]
Description=changedetection.io - self-hosted website change monitor
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/dgtlmoon/changedetection.io:latest
ContainerName=changedetection
AutoUpdate=registry

Volume=changedetection.volume:/datastore

Network=changedetection.network

# >1024 so rootless binds it without extra capabilities.
PublishPort=127.0.0.1:5000:5000

Environment=BASE_URL=http://localhost:5000
# Environment=LOGGER_LEVEL=DEBUG
# Environment=FETCH_WORKERS=10

# Uncomment to use Chrome, together with installing sockpuppetbrowser.container.
# The hostname is the browser's ContainerName, resolved by DNS on
# changedetection.network. (run.ps1 uses a pod instead, where the same thing is
# reached at ws://localhost:3000 -- do not copy that value here.)
#
# Setting this makes the app treat Chrome as available, so leave it commented
# out unless the browser is actually running.
# Environment=PLAYWRIGHT_DRIVER_URL=ws://browser-sockpuppet-chrome:3000
#
# Uncomment alongside it to have NEW watches default to Chrome rather than the
# plain HTTP fetcher. Seeds the settings default only: it applies to a fresh
# datastore, while an existing one keeps its saved value, changed under
# Settings -> Fetching -> Fetch Method.
# Environment=DEFAULT_FETCH_BACKEND=html_webdriver

[Service]
Restart=always
# First run pulls the image, which can take a few minutes on a slow link.
TimeoutStartSec=900

[Install]
WantedBy=default.target
